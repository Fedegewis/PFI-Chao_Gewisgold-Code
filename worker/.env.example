# Worker local de MenteActiva — procesa análisis IA via Ollama local.
# COPIAR a worker/.env (NO commitear) y ajustar valores reales.

# Backend al que el worker reporta trabajo. OBLIGATORIO.
# En producción debe ser HTTPS (el worker rechaza HTTP excepto para
# localhost durante desarrollo).
# Ejemplo prod: https://api.menteactiva.ar
# Ejemplo dev:  http://localhost:3001
WORKER_BACKEND_URL=http://localhost:3001

# Secreto compartido con el backend. ≥ 32 caracteres. OBLIGATORIO.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA commitear ni loggear.
WORKER_TOKEN=

# Ollama local — se asume instalado y escuchando en 127.0.0.1:11434.
WORKER_OLLAMA_URL=http://127.0.0.1:11434
WORKER_MODEL=llama3.2:3b
# Timeout del fetch a Ollama (ms). 180 s cubre inferencias del 3B en CPU
# con margen; el heartbeat del backend asegura que el lease sobreviva.
WORKER_OLLAMA_TIMEOUT_MS=180000
# Hilos de CPU que usa Ollama en cada generación (opcional, 1-64). Depende
# del procesador de ESTA máquina. Sin valor, Ollama elige el suyo.
# Medido en un i7-1255U (2 núcleos P + 8 E, 12 hilos): Ollama elegía 6;
# con 8 la generación fue ~15% más rápida, con 4 más lenta. Medir antes de
# fijarlo en otra máquina. Cambiarlo hace que Ollama recargue el modelo.
# WORKER_OLLAMA_NUM_THREAD=8

# Política operativa.
WORKER_CONCURRENCY=1
# Espera entre dos sesiones consecutivas (ms).
WORKER_DELAY_MS=10000
# Espera cuando la cola está vacía (ms).
WORKER_IDLE_POLL_MS=30000
# Cada cuánto hacer heartbeat durante una inferencia activa (ms).
# El backend emite leases de 5 min por default; 60 s deja márgen.
WORKER_HEARTBEAT_MS=60000
# Máximo tiempo que el worker espera antes de abortar backoff en errores
# recuperables del backend (/claim 5xx, red caída). Exponencial 15s..120s.
WORKER_BACKEND_RETRY_MAX_MS=120000

# Lockfile para exclusión de instancias duplicadas en la misma máquina.
# Un worker nunca arranca si existe un lockfile con un PID vivo.
# Si el archivo quedó huérfano tras un crash, se recicla automáticamente.
# Default: ./.worker.lock relativo al cwd del worker.
# WORKER_LOCK_FILE=./.worker.lock

# Nivel de log. info|debug|warn|error. Default info.
# WORKER_LOG_LEVEL=info
