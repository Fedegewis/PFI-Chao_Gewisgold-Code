# Perfil LOCAL — usar durante desarrollo contra backend en localhost.
# Copiar a worker/.env.local (NO commitear) y ajustar valores reales.
#
# Para activar este perfil al correr el worker a mano:
#   $env:WORKER_ENV_FILE = ".env.local"; npm start
#
# NUNCA uses este perfil para apuntar a Render/producción.

WORKER_BACKEND_URL=http://localhost:3001

# Token local — generar uno distinto del de producción.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
WORKER_TOKEN=

WORKER_OLLAMA_URL=http://127.0.0.1:11434
WORKER_MODEL=llama3.2:3b
WORKER_OLLAMA_TIMEOUT_MS=180000

WORKER_CONCURRENCY=1
WORKER_DELAY_MS=10000
WORKER_IDLE_POLL_MS=30000
WORKER_HEARTBEAT_MS=60000
WORKER_BACKEND_RETRY_MAX_MS=120000

# Lockfile específico del perfil local: permite a los scripts distinguir
# qué worker es cuál. NO habilita correr local y producción a la vez:
# ambos comparten Ollama. Detener producción antes (ver README).
WORKER_LOCK_FILE=./.worker.local.lock

# Archivo-centinela que dispara el shutdown cooperativo (stop-worker.ps1).
# Distinto por perfil para no interferir entre instancias.
WORKER_STOP_FLAG=./.worker.local.stop

WORKER_LOG_LEVEL=debug
