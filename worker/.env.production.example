# Perfil PRODUCCIÓN — usado exclusivamente por la tarea programada
# de Windows (MenteActivaWorker). Copiar a worker/.env.production
# (NO commitear) con los valores reales de Render.
#
# Este archivo NUNCA debe cargarse accidentalmente desde un npm start
# manual. La tarea programada setea WORKER_ENV_FILE=.env.production
# explícitamente; en desarrollo manual se carga .env o .env.local.

# URL pública del backend en Render. OBLIGATORIO HTTPS en prod.
WORKER_BACKEND_URL=https://REEMPLAZAR-CON-URL-REAL.onrender.com

# Token de producción — el MISMO configurado en el backend de Render.
# Generar/rotar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA commitear ni loggear.
WORKER_TOKEN=

WORKER_OLLAMA_URL=http://127.0.0.1:11434
WORKER_MODEL=llama3.2:3b
WORKER_OLLAMA_TIMEOUT_MS=180000

WORKER_CONCURRENCY=1
WORKER_DELAY_MS=10000
WORKER_IDLE_POLL_MS=30000
WORKER_HEARTBEAT_MS=60000
WORKER_BACKEND_RETRY_MAX_MS=120000

# Lockfile distinto para que una ejecución manual local no interfiera.
WORKER_LOCK_FILE=./.worker.production.lock

# Archivo-centinela para shutdown cooperativo desde stop-worker.ps1.
WORKER_STOP_FLAG=./.worker.production.stop

WORKER_LOG_LEVEL=info
