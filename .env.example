# Credenciales demo. Copiar este archivo como .env y ajustar los valores.
# Las variables VITE_ quedan disponibles en el bundle del cliente.
VITE_PATIENT_EMAIL=paciente@tu-dominio.com
VITE_PATIENT_PASSWORD=clave-paciente
VITE_PROFESSIONAL_EMAIL=profesional@tu-dominio.com
VITE_PROFESSIONAL_PASSWORD=clave-profesional
VITE_PROFESSIONAL_ID=psico-01
VITE_PROFESSIONAL_NAME=Nombre del Profesional

# Backend API
VITE_API_URL=http://localhost:3001/api

# Ollama (IA local). Cambiar si el servidor corre en otro host o con otro modelo.
VITE_OLLAMA_URL=http://localhost:11434/api/generate
VITE_OLLAMA_MODEL=llama3
