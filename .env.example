# Copiar este archivo como .env y ajustar los valores.
# Las variables VITE_ quedan disponibles en el bundle del cliente.
#
# NOTA: VITE_PATIENT_EMAIL, VITE_PATIENT_PASSWORD, VITE_PROFESSIONAL_EMAIL,
# VITE_PROFESSIONAL_PASSWORD y VITE_PROFESSIONAL_NAME fueron eliminadas
# en la Etapa 6C. El login usa exclusivamente el backend real.

# Id del profesional demo utilizado por los pacientes hardcodeados del PatientScreen legacy.
# NO controla autenticación real. Se elimina cuando se migre el PatientScreen.
VITE_PROFESSIONAL_ID=psico-01

# Backend API
VITE_API_URL=http://localhost:3001/api

# Google OAuth (opcional — si no está definido, el botón Google no aparece)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Ollama (IA local). Cambiar si el servidor corre en otro host o con otro modelo.
VITE_OLLAMA_URL=http://localhost:11434/api/generate
VITE_OLLAMA_MODEL=llama3
