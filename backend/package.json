{
  "name": "menteactiva-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "knex migrate:latest --knexfile src/db/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile src/db/knexfile.js",
    "seed": "knex seed:run --knexfile src/db/knexfile.js",
    "test": "node scripts/run-tests.js",
    "test:prepare": "node scripts/prepare-test-db.js",
    "db:reset": "knex migrate:rollback --all --knexfile src/db/knexfile.js && knex migrate:latest --knexfile src/db/knexfile.js && knex seed:run --knexfile src/db/knexfile.js",
    "test:coverage": "c8 node scripts/run-tests.js",
    "simulate:adaptive": "node scripts/simulate-adaptive.js",
    "analyses:review": "node scripts/regenerate-analyses.js",
    "eval:prompts": "node scripts/eval/eval-prompts.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "pg": "^8.16.0",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "supertest": "^7.1.0"
  }
}
