# PostgreSQL connection (producción)
# Si DATABASE_URL está definida, tiene prioridad sobre DB_* y se conecta con SSL.
# Formato: postgresql://USUARIO:PASSWORD@HOST:5432/BASE?sslmode=require
# DB_SSL=false desactiva SSL (solo si DATABASE_URL apunta a un Postgres sin SSL).
# DATABASE_URL=
# DB_SSL=

# PostgreSQL connection (local, usada cuando DATABASE_URL no está definida)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=menteactiva
DB_USER=postgres
DB_PASSWORD=postgres

# Base de datos SEPARADA que utiliza la suite backend cuando NODE_ENV=test.
# El nombre DEBE terminar en "_test": el knexfile aborta en caso contrario y
# la suite nunca puede correr contra menteactiva o cualquier DB de producción.
# Preparar con: npm run test:backend:prepare (o `npm --prefix backend run test:prepare`).
DB_NAME_TEST=menteactiva_test

# Server
PORT=3001

# JWT (obligatorio — el servidor no arranca sin esta variable)
JWT_SECRET=change-this-to-a-random-secret

# CORS (origen permitido para el frontend).
# Opción A (recomendada en prod): CORS_ORIGINS acepta lista separada por comas
# para soportar varias URLs (ej: dominio productivo + un preview específico).
# CORS_ORIGINS=https://menteactiva.vercel.app,https://menteactiva-preview-123.vercel.app
# Opción B (compatibilidad hacia atrás): CORS_ORIGIN acepta un único origen.
# No se soportan wildcards. Cada origen productivo o preview debe agregarse explícitamente.
CORS_ORIGIN=http://localhost:5173

# Google OAuth (opcional — si no está definido, el botón Google no aparece)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Invitaciones de pacientes: TTL en horas del token de invitación (default 168 = 7 días).
INVITATION_TTL_HOURS=168

# URL pública del frontend (usada por el backend para construir el link de invitación
# que se envía por email). Sin slash final. Ejemplo prod: https://menteactiva.vercel.app
FRONTEND_URL=http://localhost:5179

# Integración IA (Etapa 7 — Ollama local).
# AI_ENABLED debe ser exactamente "true" para habilitar llamadas al cliente Ollama.
# Cualquier otro valor (incluyendo ausencia) mantiene la IA deshabilitada:
# generate() lanza OLLAMA_DISABLED. Nada del pipeline IA corre en tests por default.
# OLLAMA_URL: base URL del servidor Ollama (sin path). Ejemplo local: http://localhost:11434
# OLLAMA_MODEL: tag del modelo pulled en Ollama (Etapa 7B fijó llama3.2:3b Q4_K_M).
# OLLAMA_TIMEOUT_MS: timeout duro para /api/generate en milisegundos.
# Mediciones reales con llama3.2:3b en CPU (Ryzen 5 3600) y prompt v1.2
# arrojaron inferencias de 60–120 s; con cold-load se acercan al techo.
# Valor recomendado para CPU: 150000 (150 s). Reducir solo si se corre Ollama
# con GPU y se validó experimentalmente que el modelo termina antes.
# AI_ENABLED=false
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_MS=150000

# Envío de emails vía Resend (opcional).
# Si RESEND_API_KEY o EMAIL_FROM no están definidas, POST /api/invitations/:id/send-email
# responde 503 con status "email_not_configured". Crear invitación + copiar link sigue
# funcionando sin estas variables.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=MenteActiva <no-reply@tu-dominio.com>
# EMAIL_REPLY_TO=soporte@tu-dominio.com
