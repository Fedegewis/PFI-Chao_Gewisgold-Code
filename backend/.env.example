# PostgreSQL connection (producción)
# Si DATABASE_URL está definida, tiene prioridad sobre DB_* y se conecta con SSL.
# Formato: postgresql://USUARIO:PASSWORD@HOST:5432/BASE?sslmode=require
# DB_SSL=false desactiva SSL (solo si DATABASE_URL apunta a un Postgres sin SSL).
# DATABASE_URL=
# DB_SSL=

# PostgreSQL connection (local, usada cuando DATABASE_URL no está definida)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=menteactiva
DB_USER=postgres
DB_PASSWORD=postgres

# Base de datos SEPARADA que utiliza la suite backend cuando NODE_ENV=test.
# El nombre DEBE terminar en "_test": el knexfile aborta en caso contrario y
# la suite nunca puede correr contra menteactiva o cualquier DB de producción.
# Preparar con: npm run test:backend:prepare (o `npm --prefix backend run test:prepare`).
DB_NAME_TEST=menteactiva_test

# Server
PORT=3001

# JWT (obligatorio — el servidor no arranca sin esta variable)
JWT_SECRET=change-this-to-a-random-secret

# CORS (origen permitido para el frontend).
# Opción A (recomendada en prod): CORS_ORIGINS acepta lista separada por comas
# para soportar varias URLs (ej: dominio productivo + un preview específico).
# CORS_ORIGINS=https://menteactiva.vercel.app,https://menteactiva-preview-123.vercel.app
# Opción B (compatibilidad hacia atrás): CORS_ORIGIN acepta un único origen.
# No se soportan wildcards. Cada origen productivo o preview debe agregarse explícitamente.
CORS_ORIGIN=http://localhost:5173

# Google OAuth (opcional — si no está definido, el botón Google no aparece)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Invitaciones de pacientes: TTL en horas del token de invitación (default 168 = 7 días).
INVITATION_TTL_HOURS=168

# URL pública del frontend (usada por el backend para construir el link de invitación
# que se envía por email). Sin slash final. Ejemplo prod: https://menteactiva.vercel.app
FRONTEND_URL=http://localhost:5179

# Integración IA (Etapa 7).
# AI_ENABLED debe ser exactamente "true" para habilitar el pipeline IA.
# Cualquier otro valor (incluyendo ausencia) mantiene la IA deshabilitada:
# generate() lanza OLLAMA_DISABLED. Nada del pipeline IA corre en tests por default.
#
# AI_PROVIDER selecciona el modo de inferencia (W-3):
#   - ausente / "ollama" → cliente Ollama in-process (dev local, default).
#   - "deferred"         → el backend NO corre inferencia. La sesión queda
#                          disponible para que un worker local la reclame
#                          vía /api/worker/analysis/* (ver sección WORKER_*).
#                          Pensado para producción con Ollama en la PC
#                          del profesional. POST /api/sessions/:id/analysis
#                          en este modo devuelve 202 "deferred_pending".
# AI_PROVIDER=ollama
#
# OLLAMA_URL: base URL del servidor Ollama (sin path). Ejemplo local: http://localhost:11434
# OLLAMA_MODEL: tag del modelo pulled en Ollama (Etapa 7B fijó llama3.2:3b Q4_K_M).
# OLLAMA_TIMEOUT_MS: timeout duro para /api/generate en milisegundos.
# Mediciones reales con llama3.2:3b en CPU (Ryzen 5 3600) y prompt v1.2
# arrojaron inferencias de 60–120 s; con cold-load se acercan al techo.
# Valor recomendado para CPU: 150000 (150 s). Reducir solo si se corre Ollama
# con GPU y se validó experimentalmente que el modelo termina antes.
# AI_ENABLED=false
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_MS=150000
#
# OLLAMA_EXTRA_HEADERS: opcional. JSON de pares string:string que se envían
# como headers adicionales en cada POST /api/generate. Pensado para servidores
# Ollama protegidos por reverse proxy / Zero Trust (ej: Cloudflare Access service
# token). Si no está definida, no se envía ningún header extra (comportamiento
# idéntico al despliegue local). No puede sobrescribir Content-Type. Valores
# inválidos abortan la llamada con OLLAMA_CONFIG_INVALID. NO loggear ni commitear.
# OLLAMA_EXTRA_HEADERS={"CF-Access-Client-Id":"xxxx.access","CF-Access-Client-Secret":"yyyy"}

# Worker local de análisis (W-1/W-2 — endpoints /api/worker/analysis/*).
# WORKER_TOKEN es un secreto compartido con el worker que corre en la PC
# del desarrollador y procesa análisis vía Ollama local. OBLIGATORIO ≥ 32
# caracteres. NO reutiliza JWT_SECRET; rotación independiente. Si no está
# definido o es demasiado corto, los endpoints /api/worker/analysis/*
# responden 503 "worker_disabled". NUNCA commitear ni loggear.
# Para generarlo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# WORKER_TOKEN=
#
# Ajustes de política de la cola de análisis (todos opcionales; defaults
# diseñados para llama3.2:3b en CPU):
#   WORKER_MODEL           — modelo "actual" que debe correr el worker.
#                            Default: OLLAMA_MODEL o "llama3.2:3b".
#   WORKER_LEASE_MS        — duración del lease emitido al claim (ms).
#                            Renovable vía POST /api/worker/analysis/heartbeat.
#                            Default: 300000 (5 min).
#   WORKER_MAX_GENERATION_ATTEMPTS — tope de intentos cuando el modelo
#                            devolvió salida incompatible (JSON inválido,
#                            schema, términos clínicos, etc). Evita bucles
#                            cuando un contexto rompe sistemáticamente la
#                            inferencia. Default: 3.
#   WORKER_MAX_TRANSIENT_ATTEMPTS — tope defensivo para fallos de infra
#                            (Ollama offline, timeout, lease vencido,
#                            modelo no instalado). Mucho más alto porque
#                            el entorno puede volverse sano. Default: 20.
#   WORKER_MAX_ATTEMPTS    — DEPRECATED alias de WORKER_MAX_GENERATION_ATTEMPTS
#                            si no se define el nuevo nombre.
#   WORKER_RETRY_COOLDOWN_MS — tiempo mínimo entre reintentos (ms) para la
#                            misma sesión tras un failed. Default: 30000.
#   WORKER_REGENERATE_OUTDATED_ANALYSES — "true" hace que la cola vuelva a
#                            analizar sesiones que ya tienen un análisis ok
#                            de una versión anterior del prompt. Default
#                            false: un cambio de PROMPT_VERSION NO regenera el
#                            historial. Para regenerar de forma controlada
#                            usar scripts/regenerate-analyses.js.
#   WORKER_GLOBAL_CONCURRENCY — cantidad máxima de leases activos al mismo
#                            tiempo. Default 1 (una inferencia Ollama por
#                            vez por instalación). Si dos procesos worker
#                            arrancan accidentalmente, el segundo recibirá
#                            204 hasta que el primero termine. Subir sólo
#                            si la instalación local justifica paralelismo.
# WORKER_MODEL=llama3.2:3b
# WORKER_LEASE_MS=300000
# WORKER_MAX_GENERATION_ATTEMPTS=3
# WORKER_MAX_TRANSIENT_ATTEMPTS=20
# WORKER_RETRY_COOLDOWN_MS=30000
# WORKER_GLOBAL_CONCURRENCY=1

# Envío de emails vía Resend (opcional).
# Si RESEND_API_KEY o EMAIL_FROM no están definidas, POST /api/invitations/:id/send-email
# responde 503 con status "email_not_configured". Crear invitación + copiar link sigue
# funcionando sin estas variables.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=MenteActiva <no-reply@tu-dominio.com>
# EMAIL_REPLY_TO=soporte@tu-dominio.com

# Logo del correo de invitación (opcional).
# URL pública HTTPS del PNG oficial de MenteActiva. Recomendado para producción:
# el PNG está en el frontend como /logo-menteactiva.png, por lo que una vez
# desplegado el frontend quedaría accesible en https://<tu-dominio>/logo-menteactiva.png
# Si no se define (o no es HTTPS), el correo cae al logo SVG inline (mismo diseño,
# menor compatibilidad en Gmail/Outlook). Nunca usar http:// ni localhost en prod.
# EMAIL_LOGO_URL=https://menteactiva.vercel.app/logo-menteactiva.png

# F2/F3 — Acceso de pacientes con enlace por correo + sesión persistente (cookie).
# Ver backend/docs/patient-passwordless-auth.md.
# PATIENT_PASSWORDLESS_ENABLED debe ser exactamente "true" para habilitar el flujo.
# Es también el kill switch: con cualquier otro valor se ocultan la opción y el
# canje de enlaces, y las cookies de sesión de paciente dejan de autenticar.
# Requiere además RESEND_API_KEY + EMAIL_FROM y FRONTEND_URL. El frontend debe
# usar la API same-origin (VITE_API_URL=/api) para que la cookie viaje.
# PATIENT_PASSWORDLESS_ENABLED=false
#
# Cookie: Secure + prefijo __Host- cuando NODE_ENV=production. Forzar con
# AUTH_COOKIE_SECURE=true|false (sólo para pruebas locales por https/http).
# AUTH_COOKIE_SECURE=
#
# Express "trust proxy": cantidad de saltos de proxy (Vercel → Render) para que
# req.ip sea la IP del cliente en el rate limit por IP. Verificar antes de fijarlo.
# TRUST_PROXY=2
#
# Límites (ventana fija). Defaults: 3 por email/15 min, 10 por email/día,
# 20 pedidos por IP/15 min, 30 canjes por IP/15 min.
# PASSWORDLESS_EMAIL_LIMIT_15MIN=3
# PASSWORDLESS_EMAIL_LIMIT_DAY=10
# PASSWORDLESS_IP_LIMIT_15MIN=20
# PASSWORDLESS_CONSUME_IP_LIMIT_15MIN=30
